{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "docs",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/guia-web.html" },
    { "source": "/guia", "destination": "/guia-web.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
