# Copiar a `.env` y ajustar. El .env NO se commitea: es la configuracion de
# TU maquina (que modelo tenes instalado, cuanto tarda un turno).
#
# Precedencia: variable exportada en el shell > .env > default del codigo.
# Solo se leen las claves con prefijo LOCALFORGE_ (este agente corre sobre
# otros repos, que tienen su propio .env con secretos ajenos).

# Provider de inferencia local
LOCALFORGE_PROVIDER=ollama
LOCALFORGE_OLLAMA_HOST=http://localhost:11434

# El modelo TIENE que soportar tool calling. Para verificarlo:
#   ollama show <modelo>    -> debe listar `tools` en Capabilities
#
# Si dejas esta linea comentada, el provider usa el primer modelo instalado que
# soporte tools y te lo dice en el health. Descomentala solo para fijar uno.
# LOCALFORGE_MODEL=qwen3:8b

# Ventana de contexto que le pedimos a Ollama (num_ctx).
# Si el prompt la excede, Ollama trunca en silencio por la izquierda y se come
# el system prompt. Vigilar la memoria al subirlo: `ollama ps` muestra cuanto
# ocupa el modelo cargado y si entra entero en GPU.
LOCALFORGE_NUM_CTX=32768

# --- budgets del harness ---------------------------------------------------
# Estos dos son los que mas cambian entre maquinas. Un modelo que pide un
# archivo por turno gasta el triple de turnos que uno que pide tres en
# paralelo, y tarda mucho mas por turno sin GPU dedicada. Si ves corridas que
# terminan en max_turns o wall_clock, subilos antes de culpar al modelo.
LOCALFORGE_MAX_TURNS=20
LOCALFORGE_WALL_CLOCK_S=300

LOCALFORGE_TOOL_TIMEOUT_S=30
LOCALFORGE_REQUEST_TIMEOUT_S=180
LOCALFORGE_TOKEN_BUDGET=200000
LOCALFORGE_TOOL_OUTPUT_LIMIT=8000

# --- paso 9 ----------------------------------------------------------------
# Modelo del juez de `eval --judge`. Vacio = el mismo del agente (y el reporte
# lo marca: un modelo juzgandose a si mismo es mas generoso).
# LOCALFORGE_JUDGE_MODEL=
# Imagen de `--sandbox`. No se descarga sola: `docker pull` la primera vez.
# LOCALFORGE_SANDBOX_IMAGE=python:3.12-slim
