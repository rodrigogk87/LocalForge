# Provider de inferencia local
LOCALFORGE_PROVIDER=ollama
LOCALFORGE_OLLAMA_HOST=http://localhost:11434
LOCALFORGE_MODEL=qwen3:14b

# Ventana de contexto que le pedimos a Ollama (num_ctx).
# qwen3:14b en una 4090 soporta comodo 32k; subir vigila la VRAM.
LOCALFORGE_NUM_CTX=32768

# Budgets del harness
LOCALFORGE_MAX_TURNS=20
LOCALFORGE_WALL_CLOCK_S=300
LOCALFORGE_TOOL_TIMEOUT_S=30
